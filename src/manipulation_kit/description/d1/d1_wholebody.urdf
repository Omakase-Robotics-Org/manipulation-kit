    <collision name="TCP_Link_L_capsule_cap_a">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
    <collision name="TCP_Link_L_capsule_cap_b">
      <origin xyz="0 -0.019 0.055" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>
  <joint name="JointTCP_L" type="fixed">
    <origin xyz="0 -0.087 0" rpy="1.5708 -1.5708 0"/>
    <parent link="Link7_L"/>
    <child link="TCP_Link_L"/>
  </joint>

  <!-- YUBI hand on arm L (mount from d1-manip-sim d1_yubi.urdf) -->
  <joint name="yubi_L_flange" type="fixed">
    <origin xyz="0 0.019 0.055" rpy="1.5708 -1.5708 3.1416"/>
    <parent link="TCP_Link_L"/>
    <child link="yubi_L_hand_root"/>
  </joint>
  <link name="yubi_L_hand_root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.26"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
    <visual>
      <origin xyz="-0.022 0 -0.02015" rpy="0 0 0"/>
      <geometry><box size="0.044 0.067 0.0735"/></geometry>
      <material name="d1_primitive"><color rgba="0.90 0.91 0.92 1"/></material>
    </visual>
    <collision name="yubi_L_palm">
      <origin xyz="-0.022 0 -0.02015" rpy="0 0 0"/>
      <geometry><box size="0.044 0.067 0.0735"/></geometry>
    </collision>
  </link>
  <joint name="yubi_L_camera_joint" type="fixed">
    <origin xyz="0 0 0.0426" rpy="0 0 0"/>
    <parent link="yubi_L_hand_root"/>
    <child link="yubi_L_hand_cam_link"/>
  </joint>
  <link name="yubi_L_hand_cam_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
    <visual>
      <origin xyz="-0.0175 0 0" rpy="0 0 0"/>
      <geometry><box size="0.035 0.032 0.042"/></geometry>
      <material name="d1_primitive"><color rgba="0.90 0.91 0.92 1"/></material>
    </visual>
    <collision name="yubi_L_cam">
      <origin xyz="-0.0175 0 0" rpy="0 0 0"/>
      <geometry><box size="0.035 0.032 0.042"/></geometry>
    </collision>
  </link>
  <!-- Wrist camera optical frame: lens along yubi_L_hand_cam_link
       +x (the approach axis), ROS optical convention. The 180 deg
       roll about the lens axis is UNVERIFIED. -->
  <joint name="yubi_L_hand_cam_optical_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <parent link="yubi_L_hand_cam_link"/>
    <child link="yubi_L_hand_cam_optical_frame"/>
  </joint>
  <link name="yubi_L_hand_cam_optical_frame">
    <!-- a frame, not a body: 1e-6 kg exists only so a
         physics importer does not substitute a default -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-06"/>
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
    </inertial>
  </link>
  <joint name="yubi_L_right_finger_joint" type="revolute">
    <origin xyz="-0.016 -0.015 0" rpy="0 0 0"/>
    <parent link="yubi_L_hand_root"/>
    <child link="yubi_L_right_finger_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.94" effort="5" velocity="2"/>
  </joint>
  <link name="yubi_L_right_finger_link">
