      <geometry><mesh filename="../d1_yubi_description_v2/yubi_description/meshes/hand_left_right_finger_link.STL"/></geometry>
      <material name="d1_yubi_shell"><color rgba="0.90 0.91 0.92 1"/></material>
    </visual>
    <!-- bounding box of yubi_description finger collision STL -->
    <collision name="yubi_L_right_finger">
      <origin xyz="0.04525 -0.0059 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.1161 0.045 0.0328"/></geometry>
    </collision>
  </link>
  <joint name="yubi_L_left_finger_joint" type="revolute">
    <origin xyz="-0.016 0.015 0" rpy="0 0 0"/>
    <parent link="yubi_L_hand_root"/>
