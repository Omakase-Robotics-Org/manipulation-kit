  <!-- D1 stock parallel gripper on arm R — vendor CAD via
       hands/d1/parallel_gripper, with the tool geometry MEASURED on
       d1-3 2026-09-16 (Shu, callipers): pad root 71 mm, pad CENTRE
       100 mm (the jaw joints), pad TIP 129 mm (the registered TCP),
       58 mm pads, 64 mm maximum opening. The previous 108.5 mm
       centre and 136 mm TCP came from vendor CAD and a d1-sdk
       default carried over with it. base_link IS the tool flange, so
       the mount is TCP_Link with no translation (+y up on both arms; _R takes the half turn).
       Mass 1.5 kg MEASURED (Shu 2026-07-29); the CAD's own 0.3279 kg
       was a shell-only export. Per-link split is an estimate, the
       total and the assembly COM (68 mm) are not. -->
  <joint name="gripper_R_flange" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.14159"/>
    <parent link="TCP_Link_R"/>
    <child link="gripper_R_base_link"/>
  </joint>
  <link name="gripper_R_base_link">
    <!-- measured 1.5 kg assembly minus the two CAD jaws; COM solved so the assembly COM is the validated 68 mm; tensor = CAD tensor x mass ratio (ESTIMATE) -->
    <inertial>
      <origin xyz="0 0 0.0666518" rpy="0 0 0"/>
      <mass value="1.4168512"/>
      <inertia ixx="0.000344766" ixy="1.21239e-06" ixz="9.16011e-07" iyy="0.000863569" iyz="3.29511e-08" izz="0.00108376"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper/base_link.STL"/></geometry>
      <material name="gripper_housing"><color rgba="0.180392 0.180392 0.180392 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.0055" rpy="0 0 0"/>
      <geometry><box size="0.057 0.057 0.007"/></geometry>
      <material name="gripper_spacer"><color rgba="0.55 0.42 0.16 1"/></material>
    </visual>
    <!-- MEASURED 7 mm spacer block between the camera plate and the gripper body (d1-3, Shu, callipers, 2026-09-16); footprint is still the CAD's own mount-plate square, which bounds a round collar or a square plate -->
    <collision name="gripper_R_gripper_spacer">
      <origin xyz="0 0 0.0055" rpy="0 0 0"/>
      <geometry><box size="0.057 0.057 0.007"/></geometry>
    </collision>
    <!-- MEASURED 42 mm actuator body: motor, gearbox, leadscrew, mount plate -->
    <collision name="gripper_R_gripper_body">
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.057 0.057 0.042"/></geometry>
    </collision>
    <!-- MEASURED 20 mm finger base plate — the jaw carriage and the guide rail bar spanning the full 160 mm of jaw travel -->
    <collision name="gripper_R_gripper_rails">
      <origin xyz="0 0 0.061" rpy="0 0 0"/>
      <geometry><box size="0.16 0.0576 0.02"/></geometry>
    </collision>
  </link>
  <joint name="gripper_R_tcp_r_joint" type="prismatic">
    <origin xyz="0 0 0.1" rpy="3.1416 -1.5708 0"/>
    <parent link="gripper_R_base_link"/>
    <child link="gripper_R_tcp_r_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0" upper="0.032" effort="3" velocity="0.05"/>
  </joint>
  <link name="gripper_R_tcp_r_link">
    <!-- CAD inertial, verbatim (41.6 g, 5.5% of the tool) -->
    <inertial>
      <origin xyz="-0.00902677 0 0.0501543" rpy="0 0 0"/>
      <mass value="0.0415744003"/>
      <inertia ixx="8.52933e-06" ixy="-1.1004e-12" ixz="2.91188e-06" iyy="1.23028e-05" iyz="1.00691e-11" izz="1.16062e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper/tcp_r_Link.STL"/></geometry>
      <material name="gripper_jaw"><color rgba="0 0.501961 0.250980 1"/></material>
    </visual>
    <!-- MEASURED pad on tcp_r_Link: 58 mm deep, root at 71 mm, tip at 129 mm from the flange; q=0 is the 64 mm OPEN gap -->
    <collision name="gripper_R_tcp_r_jaw">
      <origin xyz="0 0 0.052" rpy="0 0 0"/>
      <geometry><box size="0.058 0.038 0.04"/></geometry>
    </collision>
  </link>
  <joint name="gripper_R_tcp_l_joint" type="prismatic">
    <origin xyz="0 0 0.1" rpy="3.1416 -1.5708 0"/>
    <parent link="gripper_R_base_link"/>
    <child link="gripper_R_tcp_l_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.032" upper="0" effort="3" velocity="0.05"/>
  </joint>
  <link name="gripper_R_tcp_l_link">
    <!-- CAD inertial, verbatim (41.6 g, 5.5% of the tool) -->
    <inertial>
      <origin xyz="-0.00902676 0 -0.0501543" rpy="0 0 0"/>
      <mass value="0.0415744003"/>
      <inertia ixx="8.52933e-06" ixy="6.97442e-11" ixz="-2.91189e-06" iyy="1.23029e-05" iyz="8.22193e-12" izz="1.16063e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper/tcp_l_Link.STL"/></geometry>
      <material name="gripper_jaw"><color rgba="0 0.501961 0.250980 1"/></material>
    </visual>
    <!-- MEASURED pad on tcp_l_Link: 58 mm deep, root at 71 mm, tip at 129 mm from the flange; q=0 is the 64 mm OPEN gap -->
    <collision name="gripper_R_tcp_l_jaw">
      <origin xyz="0 0 -0.052" rpy="0 0 0"/>
      <geometry><box size="0.058 0.038 0.04"/></geometry>
    </collision>
  </link>

  <!-- Arm-end camera plate V2.0 on gripper R — the first 2 mm
       of the flange stack, MEASURED on d1-3 2026-09-16 (the CAD drop
       and the committed mesh both model an 8 mm disc; the collision
       primitive follows the calliper, the visual mesh does not).
       105 g at aluminium book density, tensor exact from the mesh.
       See the GRIPPER WRIST-CAMERA PLATE block in the generator. -->
  <joint name="gripper_R_camera_plate_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_R_base_link"/>
    <child link="gripper_R_camera_plate"/>
  </joint>
  <link name="gripper_R_camera_plate">
    <!-- mesh volume 28.95 cm^3 x aluminium 2700 kg/m^3; tensor exact from the mesh; density ASSUMED, part not yet weighed -->
    <inertial>
      <origin xyz="4e-05 0.03011 0.00721" rpy="0 0 0"/>
      <mass value="0.1053"/>
      <inertia ixx="0.00016509" ixy="-1.4487e-07" ixz="-3.0461e-09" iyy="3.4439e-05" iyz="-1.6746e-05" izz="0.00019094"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper/camera_plate_full.STL"/></geometry>
      <material name="gripper_camera_plate"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
    <!-- arm-end plate V2.0: MEASURED 2 mm flange disc, the first 2 mm of the flange stack (d1-3, Shu, callipers, 2026-09-16). The CAD drop and the committed camera_plate.STL both model an 8 mm disc; only the primitive follows the calliper, because replacing a mesh needs a CAD drop -->
    <collision name="gripper_R_camera_plate_disc">
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry><box size="0.072 0.072 0.002"/></geometry>
    </collision>
    <!-- camera-mount riser up the gripper's +y — 33 mm tall in the 2026-08-23 CAD -->
    <collision name="gripper_R_camera_plate_arm">
      <origin xyz="0 0.07445 0.0165" rpy="0 0 0"/>
      <geometry><box size="0.042 0.0509 0.033"/></geometry>
    </collision>
  </link>

  <!-- Wrist camera on the plate's mount face (the 4-hole pattern
       centre).  NOMINAL, NOT A CALIBRATED EXTRINSIC: the module on
       d1-2 has no nameplate, so its housing (16 x
       30 x 30 mm forward of the face) and the lens offset
       within it are placeholders; the optical origin sits ON the
       face.  The lens looks along +x = the face normal, 15 deg off
       the approach axis toward the fingers; image down is toward
       the fingers (the real streams show the jaws at the bottom
       edge).  Cross-checked against the d1 teleop dataset by FK,
       2026-08-21. -->
  <joint name="gripper_R_wrist_cam_mount" type="fixed">
    <origin xyz="0 0.079236 0.014543" rpy="-1.5708 -1.309 -1.5708"/>
    <parent link="gripper_R_camera_plate"/>
    <child link="gripper_R_wrist_cam_link"/>
  </joint>
  <link name="gripper_R_wrist_cam_link">
    <!-- PLACEHOLDER 30 g box module, not weighed -->
    <inertial>
      <origin xyz="0.008 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="4.5e-06" ixy="0" ixz="0" iyy="2.89e-06" iyz="0" izz="2.89e-06"/>
    </inertial>
    <visual>
      <origin xyz="0.008 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.03 0.03"/></geometry>
      <material name="gripper_wrist_camera"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
    <!-- PLACEHOLDER module housing, forward of the mount face -->
    <collision name="gripper_R_wrist_cam_housing">
      <origin xyz="0.008 0 0" rpy="0 0 0"/>
      <geometry><box size="0.016 0.03 0.03"/></geometry>
    </collision>
  </link>
  <joint name="gripper_R_wrist_cam_optical_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <parent link="gripper_R_wrist_cam_link"/>
    <child link="gripper_R_wrist_cam_optical_frame"/>
  </joint>
  <link name="gripper_R_wrist_cam_optical_frame">
    <!-- a frame, not a body: 1e-6 kg exists only so a
         physics importer does not substitute a default -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-06"/>
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09"/>
    </inertial>
  </link>


