<?xml version="1.0"?>
<!-- D1 arm RIGHT arm + YUBI parallel-jaw hand.
     Vendor "D1 arm M6-S with yubi" update (2026-06): mounts the YUBI hand on the
     arm TCP flange (TCP_Link_R) with the vendor's straight-mount transform.
     Includes the in-package arm URDF and the yubi_description hand macro.

     NOTE (2026-07-25): this straight mount is correct for the _R tree only.
     The _L tree mounts the hand 180 deg rotated (yaw pi, y-offset flipped)
     because the two arms are the same physical arm, not mirror hardware —
     see the left-side xacro and description/d1-arm-notes.md. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="d1_arm_right_with_yubi">
  <xacro:include filename="$(find d1_arm_right)/d1_arm_right.urdf"/>
  <xacro:include filename="$(find yubi_description)/urdf/yubi_hand.urdf.xacro"/>

  <xacro:yubi_hand hand_prefix="right"/>

  <joint name="d1_arm_r_tip_to_yubi" type="fixed">
    <origin xyz="0 -0.019 0.055" rpy="${radians(90)} ${radians(-90)} 0"/>
    <parent link="TCP_Link_R"/>
    <child link="right_hand_root"/>
  </joint>
</robot>
