      <geometry><box size="0.044 0.067 0.0735"/></geometry>
      <material name="yubi_gray"><color rgba="1.0 1.0 1.0 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.022 0 -0.02015" rpy="0 0 0"/>
      <geometry><box size="0.044 0.067 0.0735"/></geometry>
    </collision>
  </link>

  <joint name="yubi_R_camera_joint" type="fixed">
